# Copy this file to ".env.local" and fill in every value.
# .env.local is ignored by git, so the secrets stay on your computer.
# The README explains where each value comes from.

# --- Firebase, browser side -------------------------------------------------
# Firebase console > Project settings > General > Your apps > Web app > Config.
# These are safe to be public; the security rules protect the data.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase, server side (SECRET) -----------------------------------------
# Firebase console > Project settings > Service accounts > Generate new private key.
# Open the downloaded JSON file and copy three values from it.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the quotes and the \n characters exactly as they are in the JSON file.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Resend (SECRET) --------------------------------------------------------
# resend.com > API Keys
RESEND_API_KEY=
# The sender shown on every email. Until your own domain is verified in Resend,
# use: Your Store <onboarding@resend.dev>  (delivers only to your Resend account email)
EMAIL_FROM="Your Store <orders@yourdomain.ge>"
# Where "new order" emails go: the store's own inbox (your Gmail).
ORDER_NOTIFICATION_EMAIL=
